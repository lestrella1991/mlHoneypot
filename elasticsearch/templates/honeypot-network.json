            },
            "port": {
              "type": "integer"
            },
            "bytes": {
              "type": "long"
            },
            "packets": {
              "type": "long"
            }
          }
        },
        "destination": {
          "properties": {
            "ip": {
              "type": "ip"
            },
            "port": {
              "type": "integer"
            },
            "bytes": {
              "type": "long"
            },
            "packets": {
              "type": "long"
            }
          }
        },
        "network": {
