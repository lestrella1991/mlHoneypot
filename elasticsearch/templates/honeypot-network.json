            "transport": {
              "type": "keyword"
            },
            "protocol": {
              "type": "keyword"
            },
            "direction": {
              "type": "keyword"
            },
            "bytes": {
              "type": "long"
            },
            "packets": {
              "type": "long"
            }
          }
